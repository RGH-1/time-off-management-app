@page "/forms/review"

@using Microsoft.AspNetCore.Authorization
@using time_off_management_app.Shared.Enums
@using time_off_management_app.Shared.Constants
@using time_off_management_app.Shared.DTOs.Forms


@inject HttpClient Http

@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))



<div class="border rounded p-3 mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-3">
            <label for="personSearch" class="form-label">
                Person
            </label>

            <InputText id="personSearch"
                       class="form-control"
                       placeholder="Search by name..."
                       @bind-Value="SearchName" />
        </div>

        <div class="col-md-3">
            <label for="status" class="form-label">Status</label>
            <InputSelect id="status"
                         class="form-select"
                         @bind-Value="SelectedStatus">
                <option value="" selected>All statuses</option>

                @foreach (var status in Statuses)
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-3">
            <label for="year" class="form-label">
                Year
            </label>

            <InputSelect id="year"
                         class="form-select"
                         @bind-Value="SelectedYear">
                @for(int year = ApplicationConstants.CurrentYear; year >= ApplicationConstants.StartingYear; year--)
                {
                    <option value="@year">@year</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-3">
            <button class="btn btn-primary w-100"
                    @onclick="Search">
                Search
            </button>
        </div>

    </div>
</div>

@if (Forms.Any())
{
    <div class="border rounded p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between mb-3">

            <div>
                <InputCheckbox @bind-Value="SelectAll" />
                <span class="ms-2">
                    @SelectedForms.Count selected
                </span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success"
                        disabled="@(!SelectedForms.Any())"
                        @onclick="ApproveSelected">
                    Approve
                </button>

                <button class="btn btn-danger"
                        disabled="@(!SelectedForms.Any())"
                        @onclick="DenySelected">
                    Deny
                </button>
            </div>

        </div>

        @foreach (var form in Forms)
        {
            <div class="border rounded p-3 mb-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="d-flex gap-3">

                        @if (form.Status == ApprovalStatus.Pending)
                        {
                            <InputCheckbox @bind-Value="form.Selected" />
                        }
                        else
                        {
                            <span style="width: 16px;"></span>
                        }

                        <div>
                            <h5 class="mb-1">
                                @form.FullName
                            </h5>
                        </div>

                    </div>

                    <span class="badge rounded-pill @GetStatusClass(form.Status)">
                        @form.Status
                    </span>

                </div>

                <hr />

                <div class="row g-3">

                    <div class="col-md-2">
                        <strong>From</strong>
                        <div>
                            @form.DateTimeFrom.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="col-md-3">
                        <strong>To</strong>
                        <div>
                            @form.DateTimeTo.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="col-md-2">
                        <strong>Reason</strong>
                        <div>
                            @form.Reason.Name
                        </div>
                    </div>

                    <div class="col-md-5">
                        <strong>Description</strong>
                        <div class="text-body-secondary">
                            @(string.IsNullOrWhiteSpace(form.ReasonDescription)
                                ? "—"
                                : form.ReasonDescription)
                        </div>
                    </div>

                </div>

                <div class="mt-3">
                    <label class="form-label">
                        Review Note
                    </label>

                    <InputTextArea class="form-control"
                                   @bind-Value="form.Note"
                                   rows="2"
                                   placeholder="Optional note..."
                                   disabled="@(form.Status != ApprovalStatus.Pending)" />
                </div>

                @if (form.Status == ApprovalStatus.Pending)
                {
                    <div class="d-flex justify-content-end gap-2 mt-3">

                        <button class="btn btn-outline-danger"
                                @onclick="() => Deny(form)">
                            Deny
                        </button>

                        <button class="btn btn-success"
                                @onclick="() => Approve(form)">
                            Approve
                        </button>

                    </div>
                }

            </div>
        }
    </div>
}
else
{
    <div class="text-center text-body-secondary py-5">
        <p class="mb-0">No leave forms found.</p>
    </div>
}



@code {
    private List<TimeOffReviewDto> Forms = new();

    private string SearchName = "";
    private int SelectedYear = ApplicationConstants.CurrentYear;

    List<ApprovalStatus> Statuses = new();
    ApprovalStatus? SelectedStatus = ApprovalStatus.Pending;


    private bool SelectAll
    {
        get => Forms
            .Where(f => f.Status == ApprovalStatus.Pending)
            .All(f => f.Selected);

        set
        {
            foreach (var form in Forms.Where(f => f.Status == ApprovalStatus.Pending))
            {
                form.Selected = value;
            }
        }
    }

    private List<TimeOffReviewDto> SelectedForms =>
        Forms.Where(f =>
            f.Status == ApprovalStatus.Pending &&
            f.Selected).ToList();



    protected async override Task OnInitializedAsync()
    {
        Statuses = ApplicationConstants.ApprovalStatusList;
        await Search();
    }

    private async Task Search()
    {
        foreach (var form in Forms)
        {
            form.Selected = false;
        }

        String searchQuery = String.IsNullOrEmpty(SearchName) ? "" : $"&search ={Uri.EscapeDataString(SearchName)}";
        String statusQuery = SelectedStatus == null ? "" : $"&status={SelectedStatus}";
        String queryParams = $"?year={SelectedYear}{searchQuery}{statusQuery}";

        var res = await Http.GetAsync($"api/v1/forms/review{queryParams}");

        if(res.IsSuccessStatusCode)
        {
            var data = await res.Content.ReadFromJsonAsync<List<TimeOffReviewDto>>();
            if(data != null)
            {
                Forms = data;
            }else
            {
                Forms = new();
            }
        }
    }

    private async Task Approve(TimeOffReviewDto form)
    {
        if (form.Status != ApprovalStatus.Pending)
            return;

        
        //TODO: add approval on 1 form

        await Task.CompletedTask;
    }

    private async Task Deny(TimeOffReviewDto form)
    {
        if (form.Status != ApprovalStatus.Pending)
            return;

        // TODO: add denial on 1 form

        await Task.CompletedTask;
    }

    private async Task ApproveSelected()
    {
        var selectedForms = SelectedForms.ToList();

        if (selectedForms.Count == 0)
            return;

        // TODO: add approval on multiple forms

        await Task.CompletedTask;
    }

    private async Task DenySelected()
    {
        var selectedForms = SelectedForms.ToList();

        if (selectedForms.Count == 0)
            return;

        // TODO: add denial on multiple forms

        await Task.CompletedTask;
    }


    private string GetStatusClass(ApprovalStatus status)
    {
        return status switch
        {
            ApprovalStatus.Pending => "bg-secondary",
            ApprovalStatus.Approved => "bg-success",
            ApprovalStatus.Denied => "bg-danger",
            _ => "bg-primary"
        };
    }
}