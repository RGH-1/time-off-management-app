@page "/forms/review"

@using Microsoft.AspNetCore.Authorization
@using time_off_management_app.Shared.Enums
@using time_off_management_app.Shared.Constants
@using time_off_management_app.Shared.DTOs.Forms


@inject HttpClient Http

@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))



<div class="border rounded p-3 mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-3">
            <label for="personSearch" class="form-label">
                Person
            </label>

            <InputText id="personSearch"
                       class="form-control"
                       placeholder="Search by name..."
                       @bind-Value="SearchName" />
        </div>

        <div class="col-md-3">
            <label for="status" class="form-label">Status</label>
            <InputSelect id="status"
                         class="form-select"
                         @bind-Value="SelectedStatus">
                <option value="" selected>All statuses</option>

                @foreach (var status in Statuses)
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-3">
            <label for="year" class="form-label">
                Year
            </label>

            <InputSelect id="year"
                         class="form-select"
                         @bind-Value="SelectedYear">
                @for(int year = ApplicationConstants.CurrentYear; year >= ApplicationConstants.StartingYear; year--)
                {
                    <option value="@year">@year</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-3">
            <button class="btn btn-primary w-100"
                    @onclick="Search">
                Search
            </button>
        </div>

    </div>
</div>

@if (Forms.Any())
{
    <div class="border rounded p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between mb-3">

            <div>
                <InputCheckbox @bind-Value="SelectAll" />
                <span class="ms-2">
                    @SelectedForms.Count selected
                </span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success"
                        disabled="@(!SelectedForms.Any())"
                        @onclick="() => ConfirmBulkReview(true)">
                    Approve
                </button>

                <button class="btn btn-danger"
                        disabled="@(!SelectedForms.Any())"
                        @onclick="() => ConfirmBulkReview(false)">
                    Deny
                </button>
            </div>

        </div>

        @foreach (var form in Forms)
        {
            <div class="border rounded p-3 mb-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="d-flex gap-3">

                        @if (form.Status == ApprovalStatus.Pending)
                        {
                            <InputCheckbox @bind-Value="form.Selected" />
                        }
                        else
                        {
                            <span style="width: 16px;"></span>
                        }

                        <div>
                            <h5 class="mb-1">
                                @form.FullName
                            </h5>
                        </div>

                    </div>

                    <span class="badge rounded-pill @GetStatusClass(form.Status)">
                        @form.Status
                    </span>

                </div>

                <hr />

                <div class="row g-3">

                    <div class="col-md-2">
                        <strong>From</strong>
                        <div>
                            @form.DateTimeFrom.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="col-md-3">
                        <strong>To</strong>
                        <div>
                            @form.DateTimeTo.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="col-md-2">
                        <strong>Reason</strong>
                        <div>
                            @form.Reason.Name
                        </div>
                    </div>

                    <div class="col-md-5">
                        <strong>Description</strong>
                        <div class="text-body-secondary">
                            @(string.IsNullOrWhiteSpace(form.ReasonDescription)
                                ? "—"
                                : form.ReasonDescription)
                        </div>
                    </div>

                </div>

                <div class="mt-3">
                    <label class="form-label">
                        Review Note
                    </label>

                    <InputTextArea class="form-control"
                                   @bind-Value="form.Note"
                                   rows="2"
                                   placeholder="Optional note..."
                                   disabled="@(form.Status != ApprovalStatus.Pending)" />
                </div>

                @if (form.Status == ApprovalStatus.Pending)
                {
                    <div class="d-flex justify-content-end gap-2 mt-3">

                        <button class="btn btn-outline-danger"
                                @onclick="() => ConfirmReview(form, false)">
                            Deny
                        </button>

                        <button class="btn btn-success"
                                @onclick="() => ConfirmReview(form, true)">
                            Approve
                        </button>

                    </div>
                }

            </div>
        }
    </div>
}
else
{
    <div class="text-center text-body-secondary py-5">
        <p class="mb-0">No leave forms found.</p>
    </div>
}




@if (ShowConfirmationModal && FormToReview != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(IsApproval ? "Approve Request" : "Deny Request")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseConfirmation">
                    </button>
                </div>

                <div class="modal-body">

                    <p>
                        Are you sure you want to
                        <strong>
                            @(IsApproval ? "approve" : "deny")
                        </strong>
                        this request?
                    </p>

                    <div class="border rounded p-3">
                        <div>
                            <strong>Person:</strong>
                            @FormToReview.FullName
                        </div>

                        <div>
                            <strong>Reason:</strong>
                            @FormToReview.Reason.Name
                        </div>

                        <div>
                            <strong>Dates:</strong>
                            @FormToReview.DateTimeFrom.ToString("MMM dd, yyyy")
                            →
                            @FormToReview.DateTimeTo.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(FormToReview.Note))
                    {
                        <div class="mt-3">
                            <strong>Review Note:</strong>
                            <p class="text-body-secondary mb-0">
                                @FormToReview.Note
                            </p>
                        </div>
                    }

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseConfirmation">
                        Cancel
                    </button>

                    @if (IsApproval)
                    {
                        <button type="button"
                                class="btn btn-success"
                                @onclick="ConfirmApproval">
                            Approve
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="ConfirmDenial">
                            Deny
                        </button>
                    }
                </div>

            </div>
        </div>
    </div>
}



@if (ShowBulkConfirmation)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(IsBulkApproval
                            ? $"Approve {FormsToReview.Count} Requests"
                            : $"Deny {FormsToReview.Count} Requests")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseBulkConfirmation">
                    </button>
                </div>

                <div class="modal-body">

                    <p>
                        Are you sure you want to
                        <strong>
                            @(IsBulkApproval ? "approve" : "deny")
                        </strong>
                        the following
                        @FormsToReview.Count
                        @(FormsToReview.Count == 1 ? "request" : "requests")?
                    </p>

                    <div class="list-group">

                        @foreach (var form in FormsToReview)
                        {
                            <div class="list-group-item">

                                <div class="d-flex justify-content-between">
                                    <strong>
                                        @form.FullName
                                    </strong>

                                    <span>
                                        @form.Reason.Name
                                    </span>
                                </div>

                                <small class="text-body-secondary">
                                    @form.DateTimeFrom.ToString("MMM dd, yyyy")
                                    →
                                    @form.DateTimeTo.ToString("MMM dd, yyyy")
                                </small>

                                @if (!string.IsNullOrWhiteSpace(form.Note))
                                {
                                    <div class="mt-1">
                                        <small>
                                            <strong>Note:</strong>
                                            @form.Note
                                        </small>
                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseBulkConfirmation">
                        Cancel
                    </button>

                    @if (IsBulkApproval)
                    {
                        <button type="button"
                                class="btn btn-success"
                                @onclick="ConfirmBulkApproval">
                            Approve @FormsToReview.Count
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="ConfirmBulkDenial">
                            Deny @FormsToReview.Count
                        </button>
                    }

                </div>

            </div>
        </div>
    </div>
}



@code {
    private List<TimeOffReviewDto> Forms = new();

    private string SearchName = "";
    private int SelectedYear = ApplicationConstants.CurrentYear;

    List<ApprovalStatus> Statuses = new();
    ApprovalStatus? SelectedStatus = ApprovalStatus.Pending;


    private bool SelectAll
    {
        get => Forms
            .Where(f => f.Status == ApprovalStatus.Pending)
            .All(f => f.Selected);

        set
        {
            foreach (var form in Forms.Where(f => f.Status == ApprovalStatus.Pending))
            {
                form.Selected = value;
            }
        }
    }

    private List<TimeOffReviewDto> SelectedForms =>
        Forms.Where(f =>
            f.Status == ApprovalStatus.Pending &&
            f.Selected).ToList();



    protected async override Task OnInitializedAsync()
    {
        Statuses = ApplicationConstants.ApprovalStatusList;
        await Search();
    }

    private async Task Search()
    {
        foreach (var form in Forms)
        {
            form.Selected = false;
        }

        String searchQuery = String.IsNullOrEmpty(SearchName) ? "" : $"&search ={Uri.EscapeDataString(SearchName)}";
        String statusQuery = SelectedStatus == null ? "" : $"&status={SelectedStatus}";
        String queryParams = $"?year={SelectedYear}{searchQuery}{statusQuery}";

        var res = await Http.GetAsync($"api/v1/forms/review{queryParams}");

        if(res.IsSuccessStatusCode)
        {
            var data = await res.Content.ReadFromJsonAsync<List<TimeOffReviewDto>>();
            if(data != null)
            {
                Forms = data;
            }else
            {
                Forms = new();
            }
        }

    }





    private bool ShowConfirmationModal;
    private TimeOffReviewDto? FormToReview;
    private bool IsApproval;

    private void ConfirmReview(TimeOffReviewDto form, bool approve)
    {
        if (form.Status != ApprovalStatus.Pending)
            return;

        FormToReview = form;
        IsApproval = approve;
        ShowConfirmationModal = true;
    }

    private void CloseConfirmation()
    {
        ShowConfirmationModal = false;
        FormToReview = null;
    }


    private async Task ConfirmApproval()
    {
        if (FormToReview == null)
            return;

        var form = FormToReview;

        CloseConfirmation();

        await Approve(form);
    }

    private async Task ConfirmDenial()
    {
        if (FormToReview == null)
            return;

        var form = FormToReview;

        CloseConfirmation();

        await Deny(form);
    }


    private async Task Approve(TimeOffReviewDto form)
    {
        if (form.Status != ApprovalStatus.Pending)
            return;


        ReviewFormDto formDto = new ReviewFormDto
            {
                Note = form.Note
            };

        var res = await Http.PostAsJsonAsync<ReviewFormDto>($"api/v1/forms/{form.Id}/approve", formDto);

        if(res.IsSuccessStatusCode)
        {
            await Search();
        }
    }

    private async Task Deny(TimeOffReviewDto form)
    {
        if (form.Status != ApprovalStatus.Pending)
            return;

        ReviewFormDto formDto = new ReviewFormDto
        {
            Note = form.Note
        };

        var res = await Http.PostAsJsonAsync<ReviewFormDto>($"api/v1/forms/{form.Id}/deny", formDto);

        if (res.IsSuccessStatusCode)
        {
            await Search();
        }
    }





    private bool ShowBulkConfirmation;
    private bool IsBulkApproval;
    private List<TimeOffReviewDto> FormsToReview = new();

    private void ConfirmBulkReview(bool approve)
    {
        var selected = SelectedForms.ToList();

        if (selected.Count == 0)
            return;

        FormsToReview = selected;
        IsBulkApproval = approve;
        ShowBulkConfirmation = true;
    }

    private void CloseBulkConfirmation()
    {
        ShowBulkConfirmation = false;
        FormsToReview.Clear();
    }


    private async Task ConfirmBulkApproval()
    {
        if (FormsToReview.Count == 0)
            return;

        var forms = FormsToReview.ToList();

        CloseBulkConfirmation();

        await ApproveSelected(forms);
    }

    private async Task ConfirmBulkDenial()
    {
        if (FormsToReview.Count == 0)
            return;

        var forms = FormsToReview.ToList();

        CloseBulkConfirmation();

        await DenySelected(forms);
    }


    private async Task ApproveSelected(List<TimeOffReviewDto> forms)
    {
        var selectedForms = forms;

        if (selectedForms.Count == 0)
            return;

        var formsDto = selectedForms.Select(f => new ReviewFormDto
            {
                FormId = f.Id,
                Note = f.Note
            }).ToList();

        var res = await Http.PostAsJsonAsync<List<ReviewFormDto>>($"api/v1/forms/approve", formsDto);

        if (res.IsSuccessStatusCode)
        {
            await Search();
        }
    }

    private async Task DenySelected(List<TimeOffReviewDto> forms)
    {
        var selectedForms = forms;

        if (selectedForms.Count == 0)
            return;

        var formsDto = selectedForms.Select(f => new ReviewFormDto
        {
            FormId = f.Id,
            Note = f.Note
        }).ToList();

        var res = await Http.PostAsJsonAsync<List<ReviewFormDto>>($"api/v1/forms/deny", formsDto);

        if (res.IsSuccessStatusCode)
        {
            await Search();
        }
    }


    private string GetStatusClass(ApprovalStatus status)
    {
        return status switch
        {
            ApprovalStatus.Pending => "bg-secondary",
            ApprovalStatus.Approved => "bg-success",
            ApprovalStatus.Denied => "bg-danger",
            _ => "bg-primary"
        };
    }
}